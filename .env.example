# Copy to .env.local (development) or add in Vercel > Project > Settings > Environment Variables.

# The same MongoDB database the KeyStone desktop app uses.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=keystone-db

# Long random string used to sign sessions and login codes (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Only emails on this domain can sign in.
ALLOWED_EMAIL_DOMAIN=keystoneinvestmentllc.com

# Company mailbox that sends the 6-digit sign-in codes.
# Google Workspace: smtp.gmail.com, port 465, an App Password (not the normal password).
# Microsoft 365:    smtp.office365.com, port 587.
# Leave empty in development to print codes in the terminal instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Test/dummy deployments only. Set to 1 to allow the fixed sign-in code 000000 (and to run
# without SMTP) on a deployed build - handy for a throwaway demo site. NEVER set this on a
# deployment with real data: while on, anyone who knows an account's email can sign in with
# 000000. Leave empty/0 for real production. (Locally, 000000 always works regardless.)
ALLOW_TEST_LOGIN=
